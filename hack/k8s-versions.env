# Kubernetes versions the project tests against (RELEASING.md §5: the three most
# recent Kubernetes minors kind supports). Node images are pinned by digest, taken
# verbatim from the kind v0.33.0 release notes
# (https://github.com/kubernetes-sigs/kind/releases/tag/v0.33.0) — the only images
# guaranteed to match this kind binary.
#
# Single source of truth: scripts source this file; CI reads it (and prints it in
# the job summary). Update it when the kind binary (hack/kind-up.sh / the workflows'
# kind install step) is bumped.
#
# Shell-sourceable (KEY=VALUE, no spaces). KIND_NODE_IMAGE_* are full tag@digest refs.

# Newest supported minor — used by the main E2E and as the upgrade "to" k8s version.
K8S_NEWEST="v1.37.0"
KIND_NODE_IMAGE_NEWEST="kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5"

# Middle supported minor (not run in the upgrade matrix; listed for completeness).
K8S_MIDDLE="v1.36.4"
KIND_NODE_IMAGE_MIDDLE="kindest/node:v1.36.4@sha256:099e049362a1526b2db71494e1947aae99bd16290d7c895f2b7ea312e3cbfaed"

# Oldest supported minor — the other end of the upgrade matrix.
K8S_OLDEST="v1.35.8"
KIND_NODE_IMAGE_OLDEST="kindest/node:v1.35.8@sha256:07b2536e30b803ed61d1677a79df6115f798ce64c80f9e22f6ed45afd09323c0"
